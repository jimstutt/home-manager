{ config, pkgs, lib, ... }:

{
  home.username = "jim";
  home.homeDirectory = "/home/jim";
  home.stateVersion = "24.05";

  programs.home-manager.enable = true;

  nixpkgs.config.allowUnfree = true;

  #
  # All packages and project helper scripts in one place (correct)
  #
  home.packages = with pkgs; [
    nodejs_20
    mongodb
    git
    vim
    curl
    wget
    jq
    concurrently

    # ---- Project helper scripts ----

    (writeShellScriptBin "setup-ngologistics-d" ''
      echo "Setting up NGO Logistics D (Node.js + MongoDB)..."
      if [ -d "$HOME/Dev/NGOLogisticsD" ]; then
        cd "$HOME/Dev/NGOLogisticsD"
        npm install
        echo "NGO Logistics D setup complete!"
      else
        echo "Error: NGO Logistics D project not found"
      fi
    '')

    (writeShellScriptBin "start-ngologistics-d" ''
      echo "Starting NGO Logistics D..."
      if [ ! -d "$HOME/Dev/NGOLogisticsD" ]; then
        echo "Error: Project directory not found"
        exit 1
      fi

      # Start MongoDB (Nix store path)
      if ! pgrep -f "mongod.*27018" >/dev/null; then
        echo "Starting MongoDB on port 27018..."
        mkdir -p /tmp/ngologistics-d/mongodb-data
        ${pkgs.mongodb}/bin/mongod \
          --port 27018 \
          --dbpath /tmp/ngologistics-d/mongodb-data \
          --fork \
          --logpath /tmp/ngologistics-d/mongodb.log
        sleep 2
      fi

      cd "$HOME/Dev/NGOLogisticsD"
      ${pkgs.concurrently}/bin/concurrently \
        "cd Backend && npm run dev" \
        "cd App && npm run dev -- --port 5174" \
        --names "BACKEND-D,FRONTEND-D" \
        --prefix-colors "blue,green"
    '')

    (writeShellScriptBin "stop-ngologistics-d" ''
      echo "Stopping NGO Logistics D..."
      pkill -f "mongod.*27018"
      pkill -f "Backend.*NGOLogisticsD"
      pkill -f "vite.*5174"
      echo "Processes stopped."
    '')
  ];

  # optional environment variables
  home.sessionVariables = {
    EDITOR = "vim";
  };
}
